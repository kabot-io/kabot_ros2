<?xml version="1.0" ?>
<sdf version="1.10">
    <world name="car_world">
        <physics name="1ms" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>
        <plugin
            filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
        </plugin>
        <plugin
            filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
        </plugin>
        <plugin
            filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
        </plugin>

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                <geometry>
                    <plane>
                    <normal>0 0 1</normal>
                    </plane>
                </geometry>
                </collision>
                <visual name="visual">
                <geometry>
                    <plane>
                    <normal>0 0 1</normal>
                    <size>100 100</size>
                    </plane>
                </geometry>
                <material>
                    <ambient>0.8 0.8 0.8 1</ambient>
                    <diffuse>0.8 0.8 0.8 1</diffuse>
                    <specular>0.8 0.8 0.8 1</specular>
                </material>
                </visual>
            </link>
        </model>
        <model name="kabot" canonical_link="base_link">
            <pose>0 0 0.017 0 0 0</pose>

            <link name="base_link">
                <must_be_base_link>true</must_be_base_link>
                <inertial>
                    <pose>0 0 -0.0095 0 0 0</pose>
                    <mass>0.24</mass>
                    <inertia>
                        <ixx>0.000198</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>0.000198</iyy>
                        <iyz>0</iyz>
                        <izz>0.000396</izz>
                    </inertia>
                </inertial>
                <collision name="base_collision">
                    <pose>0 0 -0.0095 0 0 0</pose>
                    <geometry>
                        <cylinder>
                            <radius>0.0575</radius>
                            <length>0.003</length>
                        </cylinder>
                    </geometry>
                    <surface>
                        <friction>
                            <ode>
                                <mu>0.6</mu>
                                <mu2>0.6</mu2>
                            </ode>
                        </friction>
                    </surface>
                </collision>
                <visual name="base_visual">
                    <pose>0 0 -0.0095 0 0 0</pose>
                    <geometry>
                        <cylinder>
                            <radius>0.0575</radius>
                            <length>0.003</length>
                        </cylinder>
                    </geometry>
                    <material>
                        <ambient>0.12 0.14 0.16 1</ambient>
                        <diffuse>0.18 0.22 0.25 1</diffuse>
                    </material>
                </visual>
            </link>

            <joint name="left_wheel_joint" type="revolute">
                <parent>base_link</parent>
                <child>left_wheel</child>
                <pose relative_to="base_link">0 0.0505 0 0 0 0</pose>
                <axis>
                    <xyz>0 1 0</xyz>
                    <limit>
                        <lower>-1.0e16</lower>
                        <upper>1.0e16</upper>
                        <effort>0.05</effort>
                        <velocity>4.39823</velocity>
                    </limit>
                    <dynamics>
                        <damping>0.001</damping>
                        <friction>0.001</friction>
                    </dynamics>
                </axis>
            </joint>

            <link name="left_wheel">
                <pose relative_to="left_wheel_joint"/>
                <inertial>
                    <mass>0.015</mass>
                    <inertia>
                        <ixx>0.00000134</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>0.00000192</iyy>
                        <iyz>0</iyz>
                        <izz>0.00000134</izz>
                    </inertia>
                </inertial>
                <collision name="left_wheel_collision">
                    <pose>0 0 0 1.570796 0 0</pose>
                    <geometry>
                        <cylinder>
                            <radius>0.016</radius>
                            <length>0.007</length>
                        </cylinder>
                    </geometry>
                    <surface>
                        <friction>
                            <ode>
                                <mu>0.9</mu>
                                <mu2>0.9</mu2>
                            </ode>
                        </friction>
                    </surface>
                </collision>
                <visual name="left_wheel_visual">
                    <pose>0 0 0 1.570796 0 0</pose>
                    <geometry>
                        <cylinder>
                            <radius>0.016</radius>
                            <length>0.007</length>
                        </cylinder>
                    </geometry>
                    <material>
                        <ambient>0.03 0.03 0.03 1</ambient>
                        <diffuse>0.05 0.05 0.05 1</diffuse>
                    </material>
                </visual>
            </link>

            <joint name="right_wheel_joint" type="revolute">
                <parent>base_link</parent>
                <child>right_wheel</child>
                <pose relative_to="base_link">0 -0.0505 0 0 0 0</pose>
                <axis>
                    <xyz>0 1 0</xyz>
                    <limit>
                        <lower>-1.0e16</lower>
                        <upper>1.0e16</upper>
                        <effort>0.05</effort>
                        <velocity>4.39823</velocity>
                    </limit>
                    <dynamics>
                        <damping>0.001</damping>
                        <friction>0.001</friction>
                    </dynamics>
                </axis>
            </joint>

            <link name="right_wheel">
                <pose relative_to="right_wheel_joint"/>
                <inertial>
                    <mass>0.015</mass>
                    <inertia>
                        <ixx>0.00000134</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>0.00000192</iyy>
                        <iyz>0</iyz>
                        <izz>0.00000134</izz>
                    </inertia>
                </inertial>
                <collision name="right_wheel_collision">
                    <pose>0 0 0 1.570796 0 0</pose>
                    <geometry>
                        <cylinder>
                            <radius>0.016</radius>
                            <length>0.007</length>
                        </cylinder>
                    </geometry>
                    <surface>
                        <friction>
                            <ode>
                                <mu>0.9</mu>
                                <mu2>0.9</mu2>
                            </ode>
                        </friction>
                    </surface>
                </collision>
                <visual name="right_wheel_visual">
                    <pose>0 0 0 1.570796 0 0</pose>
                    <geometry>
                        <cylinder>
                            <radius>0.016</radius>
                            <length>0.007</length>
                        </cylinder>
                    </geometry>
                    <material>
                        <ambient>0.03 0.03 0.03 1</ambient>
                        <diffuse>0.05 0.05 0.05 1</diffuse>
                    </material>
                </visual>
            </link>

            <joint name="front_slider_joint" type="fixed">
                <parent>base_link</parent>
                <child>front_slider</child>
                <pose relative_to="base_link">0.040 0 -0.0145 0 0 0</pose>
            </joint>

            <joint name="rear_slider_joint" type="fixed">
                <parent>base_link</parent>
                <child>rear_slider</child>
                <pose relative_to="base_link">-0.040 0 -0.0145 0 0 0</pose>
            </joint>

            <link name="front_slider">
                <pose relative_to="front_slider_joint"/>
                <inertial><mass>0.0025</mass></inertial>
                <collision name="front_slider_collision">
                    <geometry><cylinder><radius>0.005</radius><length>0.001</length></cylinder></geometry>
                    <surface>
                        <friction><ode><mu>0.15</mu><mu2>0.15</mu2></ode></friction>
                    </surface>
                </collision>
                <visual name="front_slider_visual">
                    <geometry><cylinder><radius>0.005</radius><length>0.001</length></cylinder></geometry>
                    <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
                </visual>
            </link>

            <link name="rear_slider">
                <pose relative_to="rear_slider_joint"/>
                <inertial><mass>0.0025</mass></inertial>
                <collision name="rear_slider_collision">
                    <geometry><cylinder><radius>0.005</radius><length>0.001</length></cylinder></geometry>
                    <surface>
                        <friction><ode><mu>0.15</mu><mu2>0.15</mu2></ode></friction>
                    </surface>
                </collision>
                <visual name="rear_slider_visual">
                    <geometry><cylinder><radius>0.005</radius><length>0.001</length></cylinder></geometry>
                    <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
                </visual>
            </link>

        </model>
    </world>
</sdf>