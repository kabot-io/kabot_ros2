<?xml version="1.0"?>

<robot name="Kabot">

  <material name="white">
    <color rgba="1 1 1 1"></color>
  </material>

  <material name="blue">
    <color rgba="0 0 1 1"></color>
  </material>

  <material name="red">
    <color rgba="1 0 0 1"></color>
  </material>
  
  <material name="black">
    <color rgba="0 0 0 1"></color>
  </material>
  
  <link name="base_link">
  </link>

  <link name="chassis">
    <visual>
      <geometry>
        <box size="0.08 0.04 0.003"></box>
      </geometry>
      <material name="red"></material>
    </visual>
  </link>

  <link name="back_slider">
    <visual>
      <geometry>
        <sphere radius="0.0027"></sphere>
      </geometry>
      <material name="black"></material>
    </visual>
  </link>
  
  <link name="front_slider">
    <visual>
      <geometry>
        <sphere radius="0.0027"></sphere>
      </geometry>
      <material name="black"></material>
    </visual>
  </link>
  
  <link name="top">
    <visual>
      <geometry>
        <cylinder length="0.01" radius="0.058"></cylinder>
      </geometry>
      <material name="white"></material>
    </visual>
  </link>

  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder length="0.002" radius="0.016"></cylinder>
      </geometry>
      <material name="blue"></material>
    </visual>
  </link>

  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder length="0.002" radius="0.016"></cylinder>
      </geometry>
      <material name="blue"></material>
    </visual>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"></parent>
    <child link="chassis"></child>
    <origin xyz="-0.01 0.0 -0.0095"></origin>
  </joint>

  <joint name="front_slider_joint" type="fixed">
    <parent link="base_link"></parent>
    <child link="front_slider"></child>
    <origin xyz="0.03 0.0 -0.011"></origin>
  </joint>

  <joint name="back_slider_joint" type="fixed">
    <parent link="base_link"></parent>
    <child link="back_slider"></child>
    <origin xyz="-0.05 0.0 -0.011"></origin>
  </joint>

  <joint name="top_joint" type="fixed">
    <parent link="base_link"></parent>
    <child link="top"></child>
    <origin xyz="0.0 0.0 0.022"></origin>
  </joint>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"></parent>
    <child link="left_wheel"></child>
    <origin xyz="0.0 0.051 0.0" rpy="-1.5 0 0"></origin>
    <axis xyz="0 0 1"></axis>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"></parent>
    <child link="right_wheel"></child>
    <origin xyz="0.0 -0.051 0.0" rpy="1.5 0 0"></origin>
    <axis xyz="0 0 1"></axis>
  </joint>
  
</robot>